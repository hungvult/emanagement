# ==============================================================================
# PostgreSQL Database Credentials
# ==============================================================================
DB_NAME=emanagement_db
DB_USER=emanagement_user
DB_PASSWORD=your_secure_db_password_here
TZ=Asia/Ho_Chi_Minh

# ==============================================================================
# MinIO Object Storage Credentials
# ==============================================================================
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET=attendance-images-prod
MINIO_PUBLIC_URL=http://localhost:9000

# ==============================================================================
# Backend Configuration (Spring Boot)
# ==============================================================================
SPRING_PROFILES_ACTIVE=prod
PORT=8080
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long_min256bit
JWT_EXPIRATION_MS=1800000
JWT_REFRESH_EXPIRATION_MS=604800000
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp_email@example.com
MAIL_PASSWORD=your_smtp_app_password

# ==============================================================================
# Frontend Configuration (Next.js)
# ==============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# ==============================================================================
# Monitoring Configuration (Grafana)
# ==============================================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_secure_grafana_password
